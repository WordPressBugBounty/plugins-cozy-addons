{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cozy-block/modal",
  "title": "Popup Modal",
  "description": "Show a customizable popup or notification bar triggered by scroll, time, or exit intent.",
  "category": "cozy-block",
  "textdomain": "cozy-addons",
  "supports": {
    "html": false
  },
  "attributes": {
    "cover": {
      "type": "string",
      "default": ""
    },
    "blockClientId": {
      "type": "string",
      "default": ""
    },
    "modalType": {
      "type": "string",
      "default": "default"
    },
    "modalEvent": {
      "type": "string",
      "default": "load"
    },
    "trigger": {
      "type": "string",
      "default": "load"
    },
    "loadOnRefresh": {
      "type": "boolean",
      "default": false
    },
    "frequencyControl": {
      "type": "string",
      "default": "once_per_session"
    },
    "cooldownInterval": {
      "type": "string",
      "default": "1"
    },
    "placement": {
      "type": "string",
      "default": "center center"
    },
    "allowScroll": {
      "type": "boolean",
      "default": false
    },
    "addOverlay": {
      "type": "boolean",
      "default": true
    },
    "backgroundOverlayColor": {
      "type": "string",
      "default": "#0D0C0CAD"
    },
    "overlayBlur": {
      "type": "string",
      "default": "5px"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "pageVisibility": {
      "type": "object",
      "default": {
        "homepage": true,
        "hasAllowedList": false,
        "allowedList": [],
        "hasDenyList": false,
        "denyList": []
      }
    },
    "postTypeVisibility": {
      "type": "object",
      "default": {
        "hasAllowedList": false,
        "allowedList": [],
        "hasDenyList": false,
        "denyList": []
      }
    },
    "roleVisibility": {
      "type": "object",
      "default": {
        "hasAllowedList": true,
        "allowedList": [],
        "hasDenyList": false,
        "denyList": []
      }
    },
    "loadCondition": {
      "type": "object",
      "default": {
        "delay": 0,
        "scroll": 0
      }
    },
    "exitCondition": {
      "type": "object",
      "default": {
        "delay": 0
      }
    },
    "responsiveVisibility": {
      "type": "object",
      "default": {
        "desktop": true,
        "tablet": true,
        "mobile": true
      }
    },
    "iconStyles": {
      "type": "object",
      "default": {
        "enabled": true,
        "alignment": "right",
        "hSpacing": "0px",
        "vSpacing": "0px",
        "boxWidth": "36px",
        "boxHeight": "36px",
        "border": {
          "width": "",
          "style": "",
          "color": ""
        },
        "radius": "100px",
        "size": "15px",
        "zIndex": 1,
        "bg": "",
        "bgHover": "",
        "borderHover": "",
        "iconColor": "#141822",
        "iconColorHover": ""
      }
    },
    "clickButtonStyles": {
      "type": "object",
      "default": {
        "variation": "default",
        "placement": "bottom right",
        "content": "default",
        "label": "Open Popup",
        "imgURL": "https://plugins.cozythemes.com/cozy-addons/assets/media/play-btn.png",
        "imgAlt": "",
        "imgHasPulse": true,
        "margin": {
          "top": "",
          "right": "",
          "bottom": "",
          "left": ""
        },
        "desktop": {
          "padding": {
            "top": "14px",
            "right": "36px",
            "bottom": "14px",
            "left": "36px"
          },
          "width": "44px",
          "height": "44px",
          "font": {
            "size": ""
          }
        },
        "border": {
          "width": "",
          "style": "",
          "color": ""
        },
        "radius": "100px",
        "font": {
          "weight": "",
          "family": ""
        },
        "letterCase": "none",
        "decoration": "none",
        "lineHeight": "",
        "letterSpacing": "",
        "justify": "center",
        "color": "#fff",
        "colorHover": "",
        "bgColor": "#0c50ff",
        "bgColorHover": "",
        "borderColorHover": ""
      }
    },
    "styles": {
      "type": "object",
      "default": {
        "desktop": {
          "padding": {
            "top": "0px",
            "right": "0px",
            "bottom": "0px",
            "left": "0px"
          },
          "margin": {
            "top": "0px",
            "right": "0px",
            "bottom": "0px",
            "left": "0px"
          },
          "width": "645px",
          "height": ""
        },
        "border": {
          "width": "",
          "style": "",
          "color": ""
        },
        "radius": ""
      }
    }
  },
  "editorScript": [
    "file:./index.js",
    "file:../index.js"
  ],
  "editorStyle": "file:./index.css",
  "style": [
    "file:./style-index.css",
    "cozy-block--global-block-styles"
  ],
  "viewScript": [
    "cozy-block--modal--frontend-script"
  ],
  "render": "file:./render.php"
}