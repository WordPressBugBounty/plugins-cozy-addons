{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cozy-block/counter",
  "title": "Counter",
  "description": "Highlight important numbers, statistics, and achievements with animated counters.",
  "category": "cozy-block",
  "textdomain": "cozy-addons",
  "supports": {
    "html": false
  },
  "attributes": {
    "cover": {
      "type": "string",
      "default": ""
    },
    "blockClientId": {
      "type": "string",
      "default": ""
    },
    "prefix": {
      "type": "object",
      "default": {
        "enabled": false,
        "value": "Over"
      }
    },
    "suffix": {
      "type": "object",
      "default": {
        "enabled": false,
        "value": "+ Downloads"
      }
    },
    "endNumber": {
      "type": "string",
      "default": "10000"
    },
    "animationDuration": {
      "type": "number",
      "default": 1500
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    },
    "blockStyle": {
      "type": "object",
      "default": {
        "layout": "row",
        "gap": "8px"
      }
    },
    "styles": {
      "type": "object",
      "default": {
        "font": {
          "family": "",
          "weight": "500"
        },
        "desktop": {
          "font": {
            "size": "48px"
          }
        },
        "letterCase": "",
        "textDecoration": "",
        "lineHeight": "",
        "letterSpacing": "",
        "color": "#5566CA"
      }
    },
    "labelStyles": {
      "type": "object",
      "default": {
        "font": {
          "family": "",
          "weight": ""
        },
        "desktop": {
          "font": {
            "size": ""
          }
        },
        "letterCase": "",
        "textDecoration": "",
        "lineHeight": "",
        "letterSpacing": "",
        "color": ""
      }
    }
  },
  "editorScript": [
    "file:./index.js",
    "file:../index.js"
  ],
  "editorStyle": "file:./index.css",
  "style": [
    "file:./style-index.css",
    "cozy-block--global-block-styles"
  ],
  "viewScript": [
    "cozy-block--counter--frontend-script",
    "cozy-animejs"
  ],
  "render": "file:./render.php"
}